# Token gratuito do Cesium ion (https://ion.cesium.com/tokens).
# Sem ele o app funciona com imagem de satélite ESRI, sem relevo nem prédios 3D.
VITE_CESIUM_ION_TOKEN=

# Opcional: Google Photorealistic 3D Tiles no nível "Local" (consome cota do ion).
VITE_ENABLE_PHOTOREALISTIC=false

# Opcional: caminho base do site. O padrão "./" serve para Vercel e GitHub Pages.
# VITE_BASE=/nome-do-repo/
