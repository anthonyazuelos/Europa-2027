# Token gratuito do Cesium ion (https://ion.cesium.com/tokens).
# Sem ele o app funciona com imagem de satélite ESRI, sem relevo nem cidades em 3D.
VITE_CESIUM_ION_TOKEN=

# Cidades em 3D: Google Photorealistic 3D Tiles nos zooms de cidade e local.
# Precisa do asset do Google em "My Assets" no ion; o uso é medido pelo ion.
VITE_ENABLE_PHOTOREALISTIC=true

# Opcional: caminho base do site. O padrão "./" serve para Vercel e GitHub Pages.
# VITE_BASE=/nome-do-repo/
